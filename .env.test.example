# ─── LOCAL TEST CONFIG (template) ────────────────────────────────────
# Copy this to .env for local testing:
#
#     cp .env .env.prod.bak          # back up whatever is in .env first
#     cp .env.test.example .env      # then fill in the TEST values below
#
# ⚠️  Use a SEPARATE test bot + a SEPARATE test group here. NEVER the
#     production token/group — Telegram allows only one connection per
#     token, so a test run with the prod token crashes the live bot and
#     mutes/deletes in your real group.

# From @BotFather — create a NEW bot just for testing (/newbot)
BOT_TOKEN=your_test_bot_token_here

# From running /setup inside your TEST group (these are TEST IDs)
MAIN_GROUP_ID=-1001234567890
INTRO_TOPIC_ID=7
WELCOME_TOPIC_ID=19
ANNOUNCEMENTS_TOPIC_ID=75
# ADMIN_TOPIC_ID=66

# Local Postgres started by `npm run db:dev` (docker-compose.dev.yml)
DATABASE_URL=postgresql://bot:bot@localhost:5432/stmy_bot

# Optional AI features — leave blank to test the bot without them
OPENAI_API_KEY=
PIC_HANDLES=
